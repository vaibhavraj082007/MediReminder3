<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F8F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_gradient"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <Button android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Back"
            android:textSize="13sp"
            android:backgroundTint="#00695C"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:text="Family View"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card">

            <EditText android:id="@+id/etCode"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="16dp" android:paddingRight="16dp"
                android:hint="Paste patient's code here"
                android:textColor="#212121" android:textColorHint="#9E9E9E"/>

            <Button android:id="@+id/btnWatch"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Watch live status"
                android:textSize="16sp"
                android:backgroundTint="#00897B" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="Live status"
            android:textColor="#004D40"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <ListView android:id="@+id/listStatus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</LinearLayout>