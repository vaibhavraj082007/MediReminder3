<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="70dp"
        android:paddingBottom="30dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Medi Reminder"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"
            android:text="Never miss a dose"
            android:textColor="#B2DFDB"
            android:textSize="15sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textColor="#004D40"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="Login or create a new account"
                android:textColor="#757575"
                android:textSize="14sp"/>

            <EditText android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:hint="Email"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:inputType="textEmailAddress"/>

            <EditText android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:hint="Password (min 6 characters)"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:inputType="textPassword"/>
            <TextView android:id="@+id/tvForgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingTop="10dp"
                android:paddingBottom="2dp"
                android:text="Forgot password?"
                android:textColor="#00897B"
                android:textStyle="bold"
                android:textSize="14sp"/>



            <TextView android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="12dp"
                android:background="@drawable/bg_error"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:textSize="14sp"
                android:visibility="gone"/>
            <Button android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="Login"
                android:textSize="16sp"
                android:backgroundTint="#00897B"
                android:textColor="#FFFFFF"/>

            <Button android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:text="Create new account"
                android:textSize="16sp"
                android:backgroundTint="#E0F2F1"
                android:textColor="#00695C"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>